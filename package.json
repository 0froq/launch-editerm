{
  "name": "launch-editor-term",
  "type": "module",
  "version": "0.1.0",
  "description": "Open devtools file links in a terminal editor without hijacking the dev server TTY",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/integrations/vite.js",
    "./nuxt": "./dist/integrations/nuxt.js"
  },
  "bin": {
    "launch-editor-term": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": { "optional": true },
    "vite": { "optional": true }
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.12.0",
    "@nuxt/kit": "^3.17.2",
    "@types/node": "^22.15.3",
    "eslint": "^9.25.1",
    "tsdown": "^0.11.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.1.2"
  }
}
